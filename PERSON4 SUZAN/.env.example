# Backend REST API endpoint (for live mode)
VITE_API_URL=http://localhost:4000/api

# Mock Mode: Set to true to run completely decoupled with zero backend dependency
VITE_USE_MOCK=true

# Chain ID: 31337 (Hardhat local EVM) or 80002 (Polygon Amoy testnet)
VITE_CHAIN_ID=31337

# Block Explorer URL for transactions and contract addresses
VITE_EXPLORER_URL=https://amoy.polygonscan.com

# Optional secondary INR rate for display (1 MATIC = X INR). If unset, INR is hidden.
VITE_INR_RATE=85
