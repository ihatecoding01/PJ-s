# Backend API URL (for live mode)
VITE_API_URL=http://localhost:4000/api

# Mock Mode: Set to true to run completely decoupled with rich mock data and zero backend dependency
VITE_USE_MOCK=true

# Chain ID: 31337 (Hardhat local) or 80002 (Polygon Amoy testnet)
VITE_CHAIN_ID=31337

# Block Explorer URL for transaction and address links
VITE_EXPLORER_URL=https://amoy.polygonscan.com
