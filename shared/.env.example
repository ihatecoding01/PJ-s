# FairWork Monorepo Environment Variables - Complete Unified Reference
# Working defaults for local development

# ==========================================
# 1. HARDHAT LOCAL BLOCKCHAIN (PERSON 1) - Port 8545
# ==========================================
HARDHAT_NETWORK=localhost
HARDHAT_RPC_URL=http://127.0.0.1:8545
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Default Hardhat Account #0
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
POLYGONSCAN_API_KEY=

# ==========================================
# 2. FASTAPI AI SERVICE (PERSON 3) - Port 8000
# ==========================================
PORT=8000
HOST=0.0.0.0
# Set MOCK=false when real LLM API keys are provided
MOCK=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
GITHUB_TOKEN=
AI_INTERNAL_KEY=fairwork_internal_secret_key
GITHUB_CACHE_TTL_SECONDS=300

# ==========================================
# 3. EXPRESS + PRISMA BACKEND (PERSON 2) - Port 4000
# ==========================================
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET="fairwork-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

AI_MOCK=false
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=fairwork_internal_secret_key

CHAIN_MOCK=false
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Dedicated Oracle wallet private key (Hardhat Account #0 or separate)
ORACLE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
UPLOAD_DIR=./uploads

# ==========================================
# 4. REACT + VITE FRONTEND (PERSON 4) - Port 5173
# ==========================================
VITE_API_URL=http://localhost:4000/api
VITE_USE_MOCK=false
VITE_CHAIN_ID=31337
VITE_EXPLORER_URL=https://amoy.polygonscan.com
