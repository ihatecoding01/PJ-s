# Server Configuration
PORT=8000
HOST=0.0.0.0

# Mock Mode (Set to true for day-1 canned, schema-valid responses without LLM or GitHub API calls)
MOCK=true

# LLM Provider Configuration ("openai" or "anthropic")
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_anthropic_api_key_here
LLM_MODEL=gpt-4o

# GitHub REST API Token (Optional for public repositories; required for private repositories & higher rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# Internal Microservice Authentication (Optional; if set, incoming requests must supply X-Internal-Key header)
AI_INTERNAL_KEY=your_internal_secret_key_here

# GitHub In-Memory Cache TTL in seconds (default: 300 / 5 minutes)
GITHUB_CACHE_TTL_SECONDS=300
